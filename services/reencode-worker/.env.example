# reencode-worker — runs on the GPU host (e.g. vega). Copy to .env and fill in.
#   cp .env.example .env
# .env is gitignored; never commit real values (this repo is public).

# ssh target of the media host whose library this worker re-encodes. The worker
# pulls each source over ssh, re-encodes locally on the GPU, uploads the result
# back, and refreshes Jellyfin there. Passwordless key auth must already work.
#   e.g. user@192.168.x.x  or  user@media-host.lan
FARM_SSH_HOST=

# Jellyfin on the media host (NOT localhost — the worker is on a different box).
JELLYFIN_URL=http://media-host.lan:8096
JELLYFIN_API_KEY=

# Optional overrides (defaults shown):
# REMOTE_FFPROBE=/usr/lib/jellyfin-ffmpeg/ffprobe
# FARM_STAGE=/tmp/reencode-farm          # local scratch for the in-flight mp4
# FARM_REMOTE_QUEUE=reencode_farm        # queue dir on the media host (~/<this>)
# FARM_LOCK=/tmp/reencode-worker.lock
