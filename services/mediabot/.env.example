# cp to .env and fill. Service-specific keys only — the shared creds
# (ANTHROPIC_API_KEY, DISCORD_BOT_TOKEN, OWNER_DISCORD_ID) live in the host-level
# ../../secrets/shared.env. .arr-keys.env (radarr/sonarr/prowlarr) is written by setup.

JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=

RADARR_URL=http://localhost:7878
SONARR_URL=http://localhost:8989
PROWLARR_URL=http://localhost:9696

QBIT_URL=http://localhost:8080
QBIT_USER=admin
QBIT_PASS=

OPENSUBTITLES_API_KEY=

MODEL=claude-opus-5
MAX_TOKENS=16000
MIN_FREE_GB=8
FFMPEG=/usr/lib/jellyfin-ffmpeg/ffmpeg
FFPROBE=/usr/lib/jellyfin-ffmpeg/ffprobe
MEDIA_MOVIES=/media/JellyFin-Movies
MEDIA_SHOWS=/media/JellyFin-Shows
MEDIA_DOWNLOADS=/media/downloads

# cost meter — set your current API credit; bot warns near COST_WARN_USD
COST_CREDIT_START_USD=0
COST_WARN_USD=3
COST_WARN_COOLDOWN_H=6
