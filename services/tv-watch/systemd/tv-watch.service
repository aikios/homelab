[Unit]
Description=tv-watch — serve the TV client payloads and auto-launch the Jellyfin app on power-on
After=network-online.target
Wants=network-online.target

[Service]
User=%%DEPLOY_USER%%
WorkingDirectory=%%REPO%%/services/tv-watch
# TV_HOST / PAYLOAD_PORT live in the gitignored .env (inherited by the children
# the babysitter spawns: the payload http.server and tv_watch.py).
EnvironmentFile=%%REPO%%/services/tv-watch/.env
ExecStart=/bin/sh %%REPO%%/services/tv-watch/bin/run_watcher.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
