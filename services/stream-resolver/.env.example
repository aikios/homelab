# stream-resolver — cp to .env (gitignored). Differs per host.
#   blacklodge (primary):  STREAM_RESOLVER_PORT=8100
#   vega       (fallback): STREAM_RESOLVER_PORT=8098

STREAM_RESOLVER_PORT=8100

# LAN host/IP the TV reaches this API at. It is baked into the HLS-proxy URLs
# handed to the TV, so it must be THIS host's address on the TV's network — not
# localhost, not a name the TV can't resolve. e.g. 192.168.x.x
STREAM_RESOLVER_HOST=

# Concurrent headless-browser contexts (CPU-bound). blacklodge: 4, vega: 8.
STREAM_RESOLVER_MAX_CTX=8

# Optional faster peer to hand /prepare to, with local fallback.
# blacklodge: STREAM_RESOLVER_DELEGATE=http://<vega-lan-ip>:8098   vega: leave empty.
STREAM_RESOLVER_DELEGATE=

# Schedule/event site to scrape (https://...). Keep it ONLY here in .env:
# the site is treated as a secret and must never appear in the repo.
STREAM_RESOLVER_SOURCE_URL=
