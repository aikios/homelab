# reencode-submit — runs on the media / Jellyfin host (e.g. blacklodge).
#   cp .env.example .env     (.env is gitignored)

# Local Jellyfin, used by --scan to find items that are not direct-playable.
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=

# Where jobs are written (claimed by the GPU worker). Default shown.
# FARM_QUEUE_DIR=~/reencode_farm

# Skip files still importing: don't queue anything modified within this many
# seconds (also skips missing/zero-size). Default 120.
# FARM_STABLE_SECS=120
