[Unit]
Description=reencode-submit --scan — queue non-direct-playable Jellyfin items for the GPU farm
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%%DEPLOY_USER%%
WorkingDirectory=%%REPO%%/services/reencode-submit
# JELLYFIN_URL / JELLYFIN_API_KEY are auto-loaded by farm_submit from its sibling .env.
ExecStart=/usr/bin/python3 %%REPO%%/services/reencode-submit/src/farm_submit.py --scan
