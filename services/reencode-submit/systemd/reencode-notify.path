[Unit]
Description=Fire reencode-notify the moment the GPU farm files a job

[Path]
# The worker atomically mv-s finished jobs into these (default FARM_QUEUE_DIR).
PathChanged=/home/%%DEPLOY_USER%%/reencode_farm/done
PathChanged=/home/%%DEPLOY_USER%%/reencode_farm/failed
Unit=reencode-notify.service

[Install]
WantedBy=paths.target
