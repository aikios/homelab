# media-transcoder — cp to .env (gitignored; never commit real values, the repo is
# public). Fill in the section for the role(s) this host runs.

# ---- media host (runs submit + notify; holds the library and Jellyfin) ----
# Local Jellyfin, used by `submit --scan` to find items that aren't direct-playable.
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=
# Where jobs are written for workers to claim (default shown).
# MEDIA_TRANSCODER_QUEUE_DIR=~/reencode_farm
# Don't queue files modified within this many seconds (still importing). Default 120.
# MEDIA_TRANSCODER_STABLE_SECS=120

# ---- GPU host (runs the worker) ----
# ssh target of the media host. The worker pulls each source over ssh, re-encodes
# on the GPU, uploads the result back and refreshes Jellyfin there. Passwordless
# key auth must already work. e.g. user@192.168.x.x
MEDIA_TRANSCODER_SSH_HOST=
# Jellyfin on the media host (NOT localhost: the worker runs on a different box).
#   JELLYFIN_URL=http://media-host.lan:8096
#   JELLYFIN_API_KEY=
# Optional overrides (defaults shown):
# MEDIA_TRANSCODER_REMOTE_FFPROBE=/usr/lib/jellyfin-ffmpeg/ffprobe
# MEDIA_TRANSCODER_STAGE=/tmp/media-transcoder        # local scratch for the in-flight mp4
# MEDIA_TRANSCODER_REMOTE_QUEUE=reencode_farm         # queue dir on the media host (~/<this>)
# MEDIA_TRANSCODER_LOCK=/tmp/media-transcoder-worker.lock
# MEDIA_TRANSCODER_LOG=<service>/state/worker.log
