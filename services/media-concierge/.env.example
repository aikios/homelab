# cp to .env and fill. Service-specific keys only — the shared creds
# (ANTHROPIC_API_KEY, DISCORD_BOT_TOKEN, OWNER_DISCORD_ID) live in the host-level
# ../../secrets/shared.env. .arr-keys.env (radarr/sonarr/prowlarr) is written by setup.

JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=

RADARR_URL=http://localhost:7878
SONARR_URL=http://localhost:8989
PROWLARR_URL=http://localhost:9696

QBIT_URL=http://localhost:8080
QBIT_USER=admin
QBIT_PASS=

OPENSUBTITLES_API_KEY=

MEDIA_CONCIERGE_MODEL=claude-opus-5
MEDIA_CONCIERGE_MAX_TOKENS=16000
MEDIA_CONCIERGE_MIN_FREE_GB=8
MEDIA_CONCIERGE_FFMPEG=/usr/lib/jellyfin-ffmpeg/ffmpeg
MEDIA_CONCIERGE_FFPROBE=/usr/lib/jellyfin-ffmpeg/ffprobe
MEDIA_CONCIERGE_MOVIES_DIR=/media/JellyFin-Movies
MEDIA_CONCIERGE_SHOWS_DIR=/media/JellyFin-Shows
MEDIA_CONCIERGE_DOWNLOADS_DIR=/media/downloads

# cost meter — set your current API credit; bot warns near MEDIA_CONCIERGE_COST_WARN_USD
MEDIA_CONCIERGE_COST_CREDIT_START_USD=0
MEDIA_CONCIERGE_COST_WARN_USD=3
MEDIA_CONCIERGE_COST_WARN_COOLDOWN_H=6
