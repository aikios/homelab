[Unit]
Description=topic-watcher — daily news check, DMs new hits via the shared Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%%DEPLOY_USER%%
WorkingDirectory=%%REPO%%/services/topic-watcher
Environment=HOMELAB_SHARED_ENV=%%REPO%%/secrets/shared.env
ExecStart=%%UV%% run --no-dev --no-sync --project %%REPO%% topic-watcher
