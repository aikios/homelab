# secrets — never commit (only *.example)
.env
*.env
!*.env.example
*.env.local

# real per-host inventory (keep only hosts.example.yml)
deploy/hosts/*.local.yml

# runtime state written by services
**/state/
**/.storage/
*.sqlite
*.sqlite3

# python / uv
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.ty_cache/

# docker stack data volumes (config captured as compose, not data)
stacks/**/config/
stacks/**/data/

.DS_Store

# macOS resource-fork cruft
._*

# TV-stack per-host secrets (only the *.example files are tracked)
services/tv-launcher/jf_url.txt
services/tv-launcher/tv_token.json
