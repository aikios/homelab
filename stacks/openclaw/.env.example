# openclaw gateway — copy to .env (gitignored) and fill.
# Secrets:
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_API_KEY
DISCORD_BOT_TOKEN=REPLACE_WITH_DISCORD_BOT_TOKEN
OPENCLAW_GATEWAY_TOKEN=REPLACE_WITH_GATEWAY_TOKEN

# Image + host bind-mount locations (absolute paths on the host):
OPENCLAW_IMAGE=openclaw:local
OPENCLAW_CONFIG_DIR=/home/USER/services/openclaw/config
OPENCLAW_WORKSPACE_DIR=/home/USER/services/openclaw/workspace
OPENCLAW_AUTH_PROFILE_SECRET_DIR=/home/USER/services/openclaw/auth-secrets

# Optional (compose has sane defaults; uncomment to override):
# OPENCLAW_GATEWAY_PORT=18789
# OPENCLAW_BRIDGE_PORT=18790
# OPENCLAW_MSTEAMS_PORT=3978
# OPENCLAW_GATEWAY_BIND=lan
# OPENCLAW_TZ=America/Chicago
# CLAUDE_AI_SESSION_KEY=
# CLAUDE_WEB_SESSION_KEY=
# CLAUDE_WEB_COOKIE=
