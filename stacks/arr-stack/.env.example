# arr-stack credentials — RECORD ONLY. The docker-compose.yml here does not read
# these (the *arr apps generate their own API keys on first run, stored in each
# app's ./config). Kept so a rebuild has the secret surface documented; copy to
# .env (gitignored) and fill from each app's settings.
QBITTORRENT_WEBUI_USERNAME=admin
QBITTORRENT_WEBUI_PASSWORD=REPLACE_WITH_QBIT_WEBUI_PASSWORD
PROWLARR_API_KEY=REPLACE_WITH_PROWLARR_API_KEY
RADARR_API_KEY=REPLACE_WITH_RADARR_API_KEY
SONARR_API_KEY=REPLACE_WITH_SONARR_API_KEY
JELLYSEERR_API_KEY=REPLACE_WITH_JELLYSEERR_API_KEY
