# jellyfin-mcp — copy to .env (gitignored) and fill.
# JELLYFIN_MCP_TOKEN is consumed by docker-compose.yml (--http-token); the others
# are the upstream Jellyfin this MCP server talks to.
JELLYFIN_URL=http://host.docker.internal:8096
JELLYFIN_API_KEY=REPLACE_WITH_JELLYFIN_API_KEY
JELLYFIN_MCP_TOKEN=REPLACE_WITH_JELLYFIN_MCP_HTTP_TOKEN
